/* Eliza V3 -- estética de consola: fondo negro, verde terminal, cian para datos,
   magenta para etiquetas y dorado para el logo y los marcos de ventanas. */

Screen {
    background: #000000;
    color: #00ff00;
}

#cabecera {
    height: 7;
    padding: 1 2 0 2;
}
#logo {
    width: auto;
    padding-right: 4;
}
#info {
    width: 1fr;
    border-left: vkey #555555;
    padding-left: 2;
}

#resultados {
    height: 1fr;
    margin: 1 1 0 1;
    background: #0a0a0a;
    border: round #1f5f1f;
    scrollbar-color: #00aa00;
}
#resultados > .datatable--header {
    background: #000000;
    color: #00ff00;
    text-style: bold;
}
#resultados > .datatable--cursor {
    background: #00aa00;
    color: #000000;
    text-style: bold;
}
#resultados > .datatable--even-row {
    background: #0f0f0f;
}

#registro {
    height: 7;
    margin: 0 1;
    background: #050505;
    border: round #333333;
    border-title-color: #888888;
}

#barra {
    height: 3;
    margin: 0 1;
}
#prompt {
    width: 8;
    padding: 1 0 0 1;
    color: #00ff00;
    text-style: bold;
}
#linea {
    width: 1fr;
    background: #000000;
    color: #00ff00;
    border: tall #00aa00;
}
#linea:focus {
    border: tall #00ff00;
}
#linea > .input--placeholder {
    color: #2f6f2f;
}
#linea > .input--suggestion {
    color: #2f6f2f;
}

Footer {
    background: #000000;
}
Footer > .footer--key {
    background: #00aa00;
    color: #000000;
}

/* ---- ventanas emergentes ---- */
ModalScreen {
    align: center middle;
    background: #000000 60%;
}
.modal {
    width: 84;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: #000000;
    border: heavy #ffd700;
    border-title-color: #ffd700;
    border-title-style: bold;
    border-subtitle-color: #888888;
    padding: 1 2;
}
.modal .mensaje {
    color: #00ffff;
    margin-bottom: 1;
}
.modal .error {
    color: #ff5555;
    height: auto;
}
.modal Input {
    background: #0a0a0a;
    color: #00ffff;
    border: tall #00aa00;
    margin-bottom: 1;
}
.modal Input:focus {
    border: tall #00ff00;
}
.modal OptionList {
    background: #000000;
    border: none;
    height: auto;
    max-height: 12;
    color: #00ff00;
}
.modal OptionList > .option-list--option-highlighted {
    background: #00aa00;
    color: #000000;
    text-style: bold;
}
.modal.ancho {
    width: 110;
}
#reporte {
    height: auto;
    max-height: 30;
    background: #050505;
    border: none;
}

/* ---- formularios ---- */
.formulario {
    width: 96;
}
.rejilla {
    grid-size: 2;
    grid-columns: 18 1fr;
    grid-rows: 1;
    grid-gutter: 1 0;
    height: auto;
}
.rejilla .etiqueta {
    color: #ff66ff;
    text-style: bold;
}
/* campos compactos: una línea, sin marco; el campo activo se ilumina */
.modal .rejilla Input {
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0;
    background: #141414;
}
.modal .rejilla Input:focus {
    border: none;
    background: #003300;
    color: #ffffff;
}
.rejilla Select {
    background: #0a0a0a;
}
.rejilla Select > SelectCurrent {
    height: 1;
    background: #141414;
    color: #00ffff;
    border: none;
    padding: 0 1;
}
.rejilla Select:focus > SelectCurrent {
    border: none;
    background: #003300;
    color: #ffffff;
}
.rejilla Select > SelectOverlay {
    background: #000000;
    color: #00ff00;
    border: tall #00ff00;
}

/* ---- pantallas de trabajo (editor, bitácora, scan, logix) ---- */
.pantalla-titulo {
    height: 1;
    margin: 1 1 0 1;
    color: #ffd700;
    text-style: bold;
}
.pantalla-tabla {
    height: 1fr;
    margin: 0 1;
    background: #0a0a0a;
    border: round #1f5f1f;
    scrollbar-color: #00aa00;
}
.pantalla-tabla:focus {
    border: round #00ff00;
}
.pantalla-tabla > .datatable--header {
    background: #000000;
    color: #00ff00;
    text-style: bold;
}
.pantalla-tabla > .datatable--cursor {
    background: #00aa00;
    color: #000000;
    text-style: bold;
}
.pantalla-tabla > .datatable--even-row {
    background: #0f0f0f;
}
.pantalla-filtro {
    margin: 0 1;
    background: #000000;
    color: #00ff00;
    border: tall #1f5f1f;
}
.pantalla-filtro:focus {
    border: tall #00ff00;
}
.pantalla-estado {
    height: 1;
    margin: 0 1;
    background: #0a0a0a;
    color: #00ffff;
    padding: 0 1;
}

/* ---- explorador de archivos ---- */
.explorador {
    width: 100;
    height: 32;
}
.explorador DirectoryTree {
    height: 1fr;
    background: #050505;
    color: #00ffff;
    border: round #1f5f1f;
}
.explorador DirectoryTree:focus {
    border: round #00ff00;
}
.explorador DirectoryTree > .tree--cursor {
    background: #00aa00;
    color: #000000;
}
.explorador DirectoryTree > .directory-tree--folder {
    color: #ffd700;
}

/* ---- logix ---- */
.ruta {
    margin: 1 0 0 0;
    height: 1;
}
#lista {
    height: 8;
    margin-top: 1;
    background: #050505;
    border: round #1f5f1f;
    color: #00ffff;
}
#lista:focus {
    border: round #00ff00;
}
#lista > .option-list--option-highlighted {
    background: #00aa00;
    color: #000000;
}
.escritura {
    width: 100;
}
.valor-grande {
    height: 3;
    margin: 1 0;
    padding: 0 2;
    background: #0a0a0a;
    border: round #1f5f1f;
}
#barra {
    width: 100%;
}
#barra Bar {
    width: 1fr;
}
.parametros {
    height: 1;
    margin-bottom: 1;
}
.parametros .etiqueta {
    width: auto;
    padding-right: 1;
}
.modal .parametros Input {
    height: 1;
    width: 16;
    border: none;
    padding: 0 1;
    margin: 0 3 0 0;
    background: #141414;
}
.modal .parametros Input:focus {
    background: #003300;
    color: #ffffff;
}
.parametros Checkbox {
    height: 1;
    border: none;
    padding: 0;
    background: #000000;
    color: #00ff00;
}
.indicador {
    width: 100%;
    height: 3;
    margin: 1 0;
    text-style: bold;
    border: none;
}
.indicador.idle {
    background: #333333;
    color: #00ff00;
}
.indicador.working {
    background: #ffcc00;
    color: #000000;
}
.indicador.done {
    background: #00aa00;
    color: #000000;
}
.indicador:focus {
    text-style: bold reverse;
}
#barra Bar > .bar--bar {
    color: #00ff00;
    background: #141414;
}
#barra Bar > .bar--complete {
    color: #00ff00;
}
#historial {
    height: 8;
    background: #050505;
    border: round #333333;
}
